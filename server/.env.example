# J~Net App Store server configuration
# Copy to .env and adjust, or export these in your service unit.

PORT=8090
HOST=0.0.0.0

# Admin panel login (HTTP Basic) — change these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional GitHub token (raises API rate limits when resolving repos).
GITHUB_TOKEN=

STORE_NAME=J~Net App Store
PUBLIC_BASE_URL=https://apps.jnetai.com

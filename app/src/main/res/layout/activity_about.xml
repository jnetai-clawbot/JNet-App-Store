<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="160dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textColor="@color/accent_red"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvStoreUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Check for Update"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/dark_accent"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnShareApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Share App"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/accent_red"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStoreUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Change Store URL"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/dark_secondary"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOpenStore"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Open Store in Browser"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/dark_secondary" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Primary store is https://apps.jnetai.com (HTTPS). Cleartext is permitted
         only to ease local/LAN testing of a self-hosted store instance. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
